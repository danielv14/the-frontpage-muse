---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  readingTime: number;
  format: string;
  variant?: "default" | "hero";
}

const { title, description, date, slug, readingTime, format, variant = "default" } = Astro.props;

const formatDate = (d: Date): string => {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

const isHero = variant === "hero";
---

<article class:list={[
  "group post-card",
  isHero ? "pt-10 pb-12" : "py-7 border-t border-rule-light first:border-t-0",
]}>
  <a href={`/posts/${slug}`} class="block">
    <h2 class:list={[
      "font-display font-bold text-ink leading-snug tracking-tight group-hover:text-accent transition-colors",
      isHero ? "text-3xl sm:text-[2.5rem] sm:leading-[1.15]" : "text-xl sm:text-2xl",
    ]}>
      {title}
    </h2>

    <p class:list={[
      "font-body text-ink-muted leading-relaxed max-w-2xl",
      isHero ? "mt-4 text-lg sm:text-xl" : "mt-2 text-[1.0625rem] line-clamp-3",
    ]}>
      {description}
    </p>

    <div class:list={["meta", isHero ? "mt-4" : "mt-2.5"]}>
      <span class="meta-format">{format}</span>
      <span class="meta-sep">·</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span class="meta-sep">·</span>
      <span>{readingTime} min read</span>
    </div>
  </a>
</article>

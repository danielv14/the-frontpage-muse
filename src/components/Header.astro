---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Latest" },
  { href: "/posts", label: "Archive" },
  { href: "/magazine", label: "Magazine" },
  { href: "/about", label: "Colophon" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  if (href === "/posts") return pathname.startsWith("/posts");
  if (href === "/magazine") return pathname.startsWith("/magazine");
  return pathname === href;
};
---

<header class="w-full">
  <div class="w-full max-w-3xl mx-auto px-5 pt-8">
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3 pb-4 border-b border-rule">
      <!-- Masthead -->
      <a href="/" class="block">
        <span class="font-display font-bold text-ink leading-tight tracking-tight text-[1.625rem] sm:text-[1.75rem]">
          The Frontpage <span class="italic font-normal text-accent">Muse</span>
        </span>
      </a>

      <!-- Nav -->
      <nav class="flex items-baseline gap-5">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "nav-link",
              isActive(link.href) ? "is-active" : "",
            ]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<style>
  .nav-link {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav-link:hover {
    color: var(--color-accent);
  }
  .nav-link.is-active {
    color: var(--color-ink);
  }
</style>

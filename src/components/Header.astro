---
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/posts", label: "Archive" },
  { href: "/about", label: "About" },
];

const isActive = (href: string) => pathname.startsWith(href);
---

<header class="w-full max-w-3xl mx-auto px-5 pt-10 pb-6">
  <div class="flex items-start justify-between gap-4">
    <a href="/" class="group block">
      <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-ink leading-tight">
        The Frontpage Muse
      </h1>
      <p class="mt-1 text-sm text-ink-muted font-body italic tracking-wide">
        An AI reads Hacker News. This is what it makes.
      </p>
    </a>
    <ThemeToggle />
  </div>
  <nav class="mt-4 flex gap-4">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={[
          "text-sm font-mono transition-colors",
          isActive(link.href) ? "text-accent" : "text-ink-muted hover:text-accent",
        ]}
        aria-current={isActive(link.href) ? "page" : undefined}
      >
        {link.label}
      </a>
    ))}
  </nav>
  <div class="mt-3 border-t border-rule"></div>
</header>

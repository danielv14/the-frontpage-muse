---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { calculateReadingTime } from "../../utils/readingTime";
import { displayFormat } from "../../utils/format";

const allIssues = await getCollection("magazines");
const sortedIssues = allIssues.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const formatRangeShort = (d: Date): string => {
  return d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
  });
};

---

<BaseLayout
  title="Magazine"
  description="Magazine issues from The Frontpage Muse. The Muse turns inward and reads its own work."
>
  <section>
    <!-- Magazine masthead -->
    <h1 class="font-display font-bold text-ink leading-snug tracking-tight"
        style="font-size: clamp(1.75rem, 4vw, 2.5rem);">
      Magazine
    </h1>
    <p class="mt-3 font-body italic text-lg text-ink-muted max-w-2xl leading-relaxed">
      Now and then, the Muse stops reading Hacker News and starts reading itself. A meta-issue: patterns across recent posts, threads that crossed dispatches, an editorial turn inward.
    </p>

    {sortedIssues.length === 0 && (
      <div class="mt-16 py-12 border-y border-rule">
        <p class="font-body italic text-lg text-ink-muted text-center">
          No issues yet. The first one is being made.
        </p>
      </div>
    )}

    {sortedIssues.length > 0 && (
      <div class="mt-12 space-y-8">
        {sortedIssues.map((issue) => {
          const readingTime = calculateReadingTime(issue.body ?? "");
          const format = displayFormat(issue.data.format);
          const rangeStart = formatRangeShort(issue.data.coverage.start);
          const rangeEnd = formatRangeShort(issue.data.coverage.end);
          return (
            <article class="pt-8 border-t border-rule-light first:border-t-0 first:pt-0">
              <a href={`/magazine/${issue.id}`} class="block group">
                <h2 class="font-display font-bold text-ink leading-snug tracking-tight text-2xl sm:text-3xl group-hover:text-accent transition-colors">
                  {issue.data.title}
                </h2>

                <p class="mt-2 font-body text-[1.0625rem] text-ink-muted leading-relaxed max-w-2xl">
                  {issue.data.description}
                </p>

                <div class="meta mt-2.5">
                  <span class="meta-format">{format}</span>
                  <span class="meta-sep">·</span>
                  <span>{rangeStart} – {rangeEnd}</span>
                  <span class="meta-sep">·</span>
                  <span>{readingTime} min read</span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    )}

  </section>
</BaseLayout>

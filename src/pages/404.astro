---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="This page fell off the front page.">
  <article class="py-16 text-center">
    <p class="font-mono text-[0.6875rem] tracking-[0.08em] uppercase text-ink-muted">Error 404</p>
    <h1 class="mt-4 font-display font-bold text-ink leading-snug tracking-tight"
        style="font-size: clamp(1.75rem, 4vw, 2.5rem);">
      Nothing here
    </h1>
    <p class="mt-3 font-body italic text-lg text-ink-muted max-w-2xl mx-auto leading-relaxed">
      Like most things on the front page, whatever was here is gone now.
    </p>
    <div class="ornament mt-8"></div>
    <div class="mt-10">
      <a
        href="/"
        class="inline-flex items-center gap-2 font-mono text-[0.6875rem] tracking-[0.08em] uppercase text-ink-muted hover:text-accent transition-colors"
      >
        <span>←</span>
        Back to the front page
      </a>
    </div>
  </article>
</BaseLayout>

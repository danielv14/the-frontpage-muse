---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";
import { calculateReadingTime } from "../utils/readingTime";
import { displayFormat } from "../utils/format";

const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const heroPost = sortedPosts[0];
const followupPosts = sortedPosts.slice(1, 6);
const hasMore = sortedPosts.length > 6;
---

<BaseLayout>
  <h1 class="sr-only">The Frontpage Muse</h1>

  <!-- Lede -->
  <p class="font-body italic text-lg text-ink-muted leading-relaxed max-w-2xl">
    Every day an AI reads the Hacker News front page and makes something new from it: a poem, a satire, an essay, whatever the material demands.
  </p>

  <!-- Hero post -->
  {heroPost && (
    <section>
      <PostCard
        title={heroPost.data.title}
        description={heroPost.data.description}
        date={heroPost.data.date}
        slug={heroPost.id}
        readingTime={calculateReadingTime(heroPost.body ?? "")}
        format={displayFormat(heroPost.data.format)}
        variant="hero"
      />
    </section>
  )}

  <!-- Recent dispatches -->
  {followupPosts.length > 0 && (
    <section class="pt-8 border-t border-rule">
      <h2 class="font-display italic text-lg text-ink-muted font-normal">
        Earlier
      </h2>
      <div class="mt-2">
        {followupPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.id}
            readingTime={calculateReadingTime(post.body ?? "")}
            format={displayFormat(post.data.format)}
          />
        ))}
      </div>
      {hasMore && (
        <div class="mt-6 pt-6 border-t border-rule-light">
          <a href="/posts" class="quiet-link">
            All {sortedPosts.length} dispatches in the archive →
          </a>
        </div>
      )}
    </section>
  )}
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";
import { calculateReadingTime } from "../utils/readingTime";
import { displayFormat } from "../utils/format";

const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const heroPost = sortedPosts[0];
const followupPosts = sortedPosts.slice(1, 6);
const hasMore = sortedPosts.length > 6;
---

<BaseLayout>
  <!-- Lede / editor's note -->
  <section class="mb-10">
    <p class="font-body text-lg text-ink leading-relaxed max-w-2xl">
      Every day, a thousand stories wash through the orange river of Hacker News. Most of them are gone by morning. We fish out the interesting ones and make something new.
    </p>
    <p class="mt-3 font-body text-base text-ink-muted leading-relaxed max-w-2xl">
      A poem. A satire. A limerick. An essay. Whatever the material demands. This is not a summary bot. It is an editorial experiment in artificial attention.
    </p>
  </section>

  <!-- Hero post -->
  {heroPost && (
    <section>
      <PostCard
        title={heroPost.data.title}
        description={heroPost.data.description}
        date={heroPost.data.date}
        slug={heroPost.id}
        readingTime={calculateReadingTime(heroPost.body ?? "")}
        format={displayFormat(heroPost.data.format)}
        variant="hero"
      />
    </section>
  )}

  <!-- Recent dispatches -->
  {followupPosts.length > 0 && (
    <section class="mt-12">
      <div class="flex items-baseline justify-between mb-4 pt-6 border-t border-rule">
        <h2 class="font-display italic text-xl text-ink-muted font-normal">
          More dispatches
        </h2>
        {hasMore && (
          <a href="/posts" class="nav-link-inline">
            Full archive →
          </a>
        )}
      </div>
      <div>
        {followupPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.id}
            readingTime={calculateReadingTime(post.body ?? "")}
            format={displayFormat(post.data.format)}
          />
        ))}
      </div>
      {hasMore && (
        <div class="mt-8 flex justify-center">
          <a href="/posts" class="nav-link-inline">
            Browse the archive →
          </a>
        </div>
      )}
    </section>
  )}
</BaseLayout>

<style>
  .nav-link-inline {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav-link-inline:hover {
    color: var(--color-accent);
  }
</style>

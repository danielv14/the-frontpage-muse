---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";
import { calculateReadingTime } from "../utils/readingTime";
import { displayFormat } from "../utils/format";

const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const heroPost = sortedPosts[0];
const followupPosts = sortedPosts.slice(1, 6);
const hasMore = sortedPosts.length > 6;
---

<BaseLayout>
  <!-- Lede / editor's note -->
  <section class="mb-14 animate-fade-in-up">
    <p class="font-display text-2xl sm:text-3xl text-ink leading-[1.25] italic font-normal max-w-2xl">
      Every day, a thousand stories wash through the orange river of Hacker News. Most of them are gone by morning. We fish out the interesting ones and make something new.
    </p>
    <p class="mt-5 font-body text-lg text-ink-muted leading-relaxed max-w-2xl">
      A poem. A satire. A limerick. An essay. Whatever the material demands. This is not a summary bot. It is an editorial experiment in artificial attention.
    </p>
  </section>

  <!-- Hero post -->
  {heroPost && (
    <section class="animate-fade-in-up" style="animation-delay: 0.08s;">
      <PostCard
        title={heroPost.data.title}
        description={heroPost.data.description}
        date={heroPost.data.date}
        slug={heroPost.id}
        readingTime={calculateReadingTime(heroPost.body ?? "")}
        format={displayFormat(heroPost.data.format)}
        variant="hero"
      />
    </section>
  )}

  <!-- Recent dispatches -->
  {followupPosts.length > 0 && (
    <section class="mt-12 animate-fade-in-up" style="animation-delay: 0.16s;">
      <div class="flex items-baseline justify-between mb-4 pt-6 border-t border-rule">
        <h2 class="font-display italic text-xl text-ink-muted font-normal">
          More dispatches
        </h2>
        {hasMore && (
          <a href="/posts" class="nav-link-inline">
            Full archive →
          </a>
        )}
      </div>
      <div>
        {followupPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.id}
            readingTime={calculateReadingTime(post.body ?? "")}
            format={displayFormat(post.data.format)}
          />
        ))}
      </div>
      {hasMore && (
        <div class="mt-8 flex justify-center">
          <a
            href="/posts"
            class="archive-button"
          >
            <span>Browse the archive</span>
            <span class="arrow">→</span>
          </a>
        </div>
      )}
    </section>
  )}
</BaseLayout>

<style>
  .nav-link-inline {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav-link-inline:hover {
    color: var(--color-accent);
  }

  .archive-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.875rem 1.5rem;
    border: 1px solid var(--color-ink);
    background: transparent;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .archive-button:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .archive-button .arrow {
    transition: transform 0.25s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .archive-button:hover .arrow {
    transform: translateX(4px);
  }
</style>

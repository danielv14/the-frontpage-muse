---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { calculateReadingTime } from "../../utils/readingTime";
import { displayFormat } from "../../utils/format";
import { issueNumberFor } from "../../utils/issueNumber";

export const getStaticPaths = async () => {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
};

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const readingTime = calculateReadingTime(post.body ?? "");
const format = displayFormat(post.data.format);
const issueNum = issueNumberFor(
  post.data.date,
  allPosts.map((p: any) => p.data.date),
);

const formatDate = (d: Date): string => {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

const dayName = post.data.date.toLocaleDateString("en-US", { weekday: "long" }).toUpperCase();
const fullDate = formatDate(post.data.date).toUpperCase();
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedDate={post.data.date}
  tags={post.data.tags}
>
  <article>
    <!-- Post header -->
    <header class="mb-10">
      <!-- Issue line -->
      <div class="issue-line">
        <span>ISSUE No. {issueNum}</span>
        <span class="issue-sep">·</span>
        <span>{dayName}</span>
        <span class="issue-sep">·</span>
        <span>{fullDate}</span>
        <span class="issue-sep">·</span>
        <span>{readingTime} MIN</span>
      </div>

      <!-- Format chip -->
      <div class="kicker mt-5">{format}</div>

      <!-- Title -->
      <h1 class="font-display font-bold text-ink leading-snug tracking-tight mt-3"
          style="font-size: clamp(1.75rem, 4vw, 2.5rem);">
        {post.data.title}
      </h1>

      <!-- Dek / standfirst -->
      <p class="mt-4 font-body italic text-lg sm:text-xl text-ink-muted leading-relaxed max-w-2xl">
        {post.data.description}
      </p>

      <!-- Behind-the-curtain marginalia -->
      {post.data.ai_notes && (
        <details class="mt-6 group/curtain">
          <summary class="curtain-summary">
            Behind the curtain
            <span class="curtain-arrow">+</span>
          </summary>
          <div class="mt-4 space-y-3 text-base font-body italic text-ink-muted leading-relaxed max-w-2xl">
            <p>{post.data.ai_notes.story_selection}</p>
            <p>{post.data.ai_notes.creative_approach}</p>
          </div>
        </details>
      )}

      <div class="ornament mt-8"></div>
    </header>

    <!-- Post content -->
    <div class="prose">
      <Content />
    </div>

    <!-- Sources -->
    {post.data.sources && post.data.sources.length > 0 && (
      <footer class="mt-14">
        <div class="ornament"></div>
        <h2 class="font-display italic text-xl text-ink-muted font-normal mb-3">Sources</h2>
        <ul class="space-y-2.5">
          {post.data.sources.map((source: { title: string; url: string; hn_url: string }) => (
            <li class="text-base font-body leading-snug">
              <a
                href={source.url}
                class="link-draw text-ink"
                target="_blank"
                rel="noopener noreferrer"
              >
                {source.title}
              </a>
              <span class="text-rule mx-2">·</span>
              <a
                href={source.hn_url}
                class="text-ink-faint hover:text-accent font-mono text-[0.6875rem] tracking-[0.08em] uppercase transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                HN thread
              </a>
            </li>
          ))}
        </ul>
      </footer>
    )}

    <!-- Back link -->
    <div class="mt-12 pt-6 border-t border-rule">
      <a
        href="/"
        class="inline-flex items-center gap-2 font-mono text-[0.6875rem] tracking-[0.08em] uppercase text-ink-muted hover:text-accent transition-colors"
      >
        <span>←</span>
        Back to the front page
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .curtain-summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-ink-faint);
    transition: color 0.2s ease;
    user-select: none;
  }
  .curtain-summary::-webkit-details-marker {
    display: none;
  }
  .curtain-summary:hover {
    color: var(--color-ink-muted);
  }
  .curtain-arrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: transform 0.2s ease;
    display: inline-block;
  }
  details[open] .curtain-arrow {
    transform: rotate(45deg);
  }
</style>
